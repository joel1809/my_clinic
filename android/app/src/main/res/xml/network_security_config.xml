<?xml version="1.0" encoding="utf-8"?>
<!--
    Build de production : tout le trafic doit passer en HTTPS, sans exception.

    Les tolérances HTTP en clair nécessaires au développement (php artisan
    serve sur le PC, émulateur, Wi-Fi local) vivent dans la variante debug,
    android/app/src/debug/res/xml/network_security_config.xml, qui remplace ce
    fichier dans les builds de développement. Elles ne sont donc jamais
    embarquées dans un APK distribué.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
